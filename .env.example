# Discord Bot
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_APP_ID=your_discord_application_id_here

# Set this to your test server ID for instant command updates during development.
# Leave empty in production to register commands globally.
DISCORD_DEV_GUILD_ID=

# Bot Presence
# Status: online | idle | dnd | invisible
BOT_STATUS=online
# Activity type: playing | watching | listening | competing | streaming
BOT_ACTIVITY_TYPE=watching
# Activity text shown in Discord (e.g. "Watching over your channels")
BOT_ACTIVITY_TEXT=over your channels

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=gltchbot
DB_PASSWORD=changeme
DB_NAME=gltchbot
DB_SSLMODE=disable

# Connection pool settings (optional)
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# API
API_PORT=8080
API_KEY=change_this_to_a_secure_random_string
