# Discord Bot
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_APP_ID=your_discord_application_id_here

# Environment: production, development, staging (default: development)
GO_ENV=development

# Set this to your test server ID for instant command updates during development.
# Leave empty in production to register commands globally.
DISCORD_DEV_GUILD_ID=

# Bot Presence
# Status: online | idle | dnd | invisible
BOT_STATUS=online
# Activity type: playing | watching | listening | competing | streaming
BOT_ACTIVITY_TYPE=watching
# Activity text shown in Discord (e.g. "Watching over your channels")
BOT_ACTIVITY_TEXT=over your channels

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=gltchbot
DB_PASSWORD=changeme
DB_NAME=gltchbot
DB_SSLMODE=disable

# Connection pool settings (optional)
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# API
API_PORT=8080
# API key(s) - comma-separated for multiple keys (minimum 32 chars, use high-entropy random strings)
# Generate with: openssl rand -base64 32 | tr -d '\n'
API_KEY=change_this_to_a_secure_random_string,second_key_here
# Old API keys (optional) - comma-separated list of keys being rotated out
OLD_API_KEYS=
# Request size limit (e.g., "10MB", "100KB", "1GB", default: "10MB")
REQUEST_SIZE_LIMIT=10MB

# API rate limiting (requests per second)
API_RATE_LIMIT_GLOBAL=100
API_RATE_LIMIT_AUTH=50
API_RATE_LIMIT_UNAUTH=10
API_RATE_LIMIT_BURST=2

# Audit logging
# Level: debug | info | warn | error (default: info)
AUDIT_LOG_LEVEL=info

# Security headers
# HSTS max-age in seconds (default: 1 year)
SECURITY_HSTS_MAX_AGE=31536000
# Content-Security-Policy (optional, default: "default-src 'self'; style-src 'self' 'unsafe-inline'")
# SECURITY_CSP=
# Permissions-Policy (optional, default: "camera=(), microphone=(), geolocation=()")
# SECURITY_PERMISSIONS_POLICY=

# CORS (Cross-Origin Resource Sharing)
# Allowed origins (comma-separated, default: "*" for development)
CORS_ALLOWED_ORIGINS=*
# Allowed methods (comma-separated, default: "GET, POST, PUT, PATCH, DELETE, OPTIONS")
CORS_ALLOWED_METHODS=GET, POST, PUT, PATCH, DELETE, OPTIONS
# Allowed headers (comma-separated, default: "Content-Type, X-API-Key, Authorization")
CORS_ALLOWED_HEADERS=Content-Type, X-API-Key, Authorization
# Exposed headers (comma-separated, optional)
# CORS_EXPOSED_HEADERS=
# Max age for preflight cache in seconds (default: 86400 = 24 hours)
CORS_MAX_AGE=86400
# Allow credentials (cookies/authentication) (default: true for development)
CORS_ALLOW_CREDENTIALS=true
